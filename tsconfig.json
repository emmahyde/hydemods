{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "types": ["bun", "assets"],
    "lib": ["esnext", "dom.asynciterable"]
  },
  "include": ["index.ts", "lib/**/*.ts", "tests/**/*.ts"]
}
